* =====================================================================
* SMOKE-TEST MODELS ONLY - generic placeholders to check netlist syntax,
* connectivity and DC bias. Replace with vendor/published models
* (JRC4558, 2N4401, 1N914, red LED) before collecting real metrics.
* =====================================================================

* Generic single-pole op-amp, rail-clamped output. Pins: inp inn vcc vee out
.subckt JRC4558_HALF inp inn vcc vee out
Rin  inp inn 1Meg
E1   g mid inp inn 1e5
Em   mid 0 vcc vee 0.5
Rp   g p 1k
Cp   p mid 5.3u          ; ~30 Hz open-loop pole -> GBW ~3 MHz
B1   o 0 V = (V(vcc)+V(vee))/2 + ((V(vcc)-V(vee))/2-1)*tanh((V(p)-(V(vcc)+V(vee))/2)/((V(vcc)-V(vee))/2-1))
Ro   o out 50
.ends

.model Q2N4401  NPN(Is=26f Bf=200 Vaf=90 Cje=24p Cjc=11p Tf=0.5n Rb=10)
.model D1N914   D(Is=2.52n Rs=0.568 N=1.752 Cjo=4p tt=20n)
.model DLED_RED D(Is=1e-20 N=1.6 Rs=5 Cjo=20p)   ; ~1.7-1.8 V at mA level

* 741 placeholder: same generic op-amp (no slew-rate limit yet!)
.subckt LM741 inp inn vcc vee out
X1 inp inn vcc vee out JRC4558_HALF
.ends

.model DGE     D(Is=2e-7 N=1.3 Rs=10 Cjo=1p)     ; germanium-like, ~0.3 V at 1 mA
.model Q2N3904 NPN(Is=6.7f Bf=300 Vaf=74 Cje=4.5p Cjc=3.6p Tf=0.3n Rb=10)
.model QBC109C NPN(Is=10f Bf=520 Vaf=60 Cje=10p Cjc=4p Tf=0.5n Rb=10)
